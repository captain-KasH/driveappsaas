# Names and safe placeholders only. Never commit real values.

# API runtime: must connect as taxios_app (no superuser, no BYPASSRLS).
DATABASE_URL=postgres://taxios_app:CHANGE_ME@localhost:5432/taxios_dev
ADDR=:8080

# Schema owner, used only by `taxios-api migrate` and `create-platform-admin`.
MIGRATE_DATABASE_URL=postgres://OWNER:CHANGE_ME@localhost:5432/taxios_dev

# Used once by `create-platform-admin`.
TAXIOS_ADMIN_PASSWORD=CHANGE_ME

# Tests (set by `make test`).
TAXIOS_TEST_MIGRATE_URL=postgres://localhost:5432/taxios_test
TAXIOS_TEST_DATABASE_URL=postgres://taxios_app:CHANGE_ME@localhost:5432/taxios_test
