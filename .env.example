# Taxios API environment (copy to services/api/.env for local runs; the server uses deploy/.env + compose.yml).
# Every variable the binary reads is listed here. Secrets: placeholders only — never commit real values.

# serve ------------------------------------------------------------------------------------------
DATABASE_URL=postgres://taxios_app:CHANGE_ME@localhost:5432/taxios_dev   # must be the non-superuser, non-BYPASSRLS app role
ADDR=:8080                                                               # listen address
TAXIOS_TRUST_PROXY=0                                                     # 1 only behind our own nginx (client IP from X-Real-IP)
TAXIOS_ALLOW_RLS_BYPASS=0                                                # never 1 outside local debugging

# migrate / create-platform-admin ---------------------------------------------------------------
MIGRATE_DATABASE_URL=postgres://taxios_owner:CHANGE_ME@localhost:5432/taxios_dev   # schema owner role
TAXIOS_ADMIN_PASSWORD=CHANGE_ME                                          # only for `create-platform-admin`, 10–72 chars

# tests ------------------------------------------------------------------------------------------
TAXIOS_TEST_MIGRATE_URL=postgres://owner:owner@localhost:5432/taxios_test?sslmode=disable
TAXIOS_TEST_DATABASE_URL=postgres://taxios_app:test_app@localhost:5432/taxios_test?sslmode=disable
